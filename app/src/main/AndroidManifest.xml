<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 投屏二维码：相机扫码（社区 3.5.3-qrscan）；硬件声明为可选，无相机设备仍可粘贴 URL -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- P2P 建连（Wi-Fi Direct）所需；前两个是 normal 级权限，安装即授予 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      ★★★ 连车机 AP 走 ConnectivityManager.requestNetwork()（WifiNetworkSpecifier），
        框架层要求 CHANGE_NETWORK_STATE，否则 requestNetwork 直接抛 SecurityException，
        「连接车辆 / 一键 OTA」会静默崩。该权限是 normal 级，安装即授予，但清单必须声明。
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      ★★★ WRITE_SETTINGS（修改系统设置）：
        OtaP2p 用 WifiManager.setWifiEnabled() 开关 Wi-Fi，该方法在 API 29+ 必须持有
        WRITE_SETTINGS 否则抛 SecurityException；且它是 special 级权限，不能普通弹窗申请，
        必须由用户去系统设置页授予（ACTION_MANAGE_WRITE_SETTINGS）。声明 + 运行时引导缺一不可。
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
      ★ mDNS 发现车机 `_EasyConn._tcp.local.`（2026-10-05）。
        没有 CHANGE_WIFI_MULTICAST_STATE 时，NsdManager 收不到组播响应，
        discoverServices 会静默回调 onDiscoveryStarted 却永不出 onServiceFound。
        该权限自 API 12 起不再需要用户手动授予，但清单里必须声明。
        运行时仍需 acquireMulticastLock()（见 OtaMdnsProbe）。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      ★ Android 14 (API 34) 起，声明foregroundServiceType="dataSync" 的前台服务
        必须同时有 FOREGROUND_SERVICE_DATA_SYNC，否则 startForeground() 直接抛异常。
        推送 106MB 需要前台服务保活，见 OtaPushService。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      ★★★ 必须声明 INTERNET，否则「最后一公里」整条链路都是静默失效的（2026-10-05 实测）：
        ① Socket.connect() 在无 INTERNET 权限的进程里抛 SecurityException ——
           OtaP2p.resolveAdbHost() 的 catch(Throwable) 会把它吞掉，于是**永远扫不到任何 5555**，
           日志只会打「候选 … 里都没有 5555 开着」，看不出是权限问题；
        ② NetworkInterface.getNetworkInterfaces() 只返回 loopback ——
           读不到 p2p0，判不出「组已成型」、也算不出 GO 网段。
      P2P + ADB 推包本质上就是网络操作，这个权限是必需的，不是可选项。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      ★ P2P discovery（Android 6–12）需要运行时定位权限，否则 discoverPeers 恒 BUSY/无结果。
        Android 12 起同时请求 COARSE + FINE，让用户看到「精确位置」开关（社区 3.5.1-p2pfix）。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <!--
      ★★★ 蓝牙（BLE 透传诊断链路，2026-10-15 移植 第三方诊断工具 iOS 版）：
        iOS 版的主诊断通道不是 Wi-Fi DoIP，而是经 HC-02 / I6328A-485 / ESP32-CANE 这类
        **串口透传模块**直连车辆 RS485 针脚或 CAN 总线 —— 手机直接上总线，不经过车机热点。
        这是「换胎压传感器 / 清 ABS 泵 / NFC 学卡」这类只有总线层能做的事的唯一路径。

        ★ Android 12 (API 31) 起 BLUETOOTH_SCAN / BLUETOOTH_CONNECT 归入「附近设备」权限族
          （dangerous，运行时申请）。缺这两条时 BluetoothLeScanner.startScan 直接抛
          SecurityException，且现象与「模块没上电」一样（扫不到任何设备）——极易误判。
          ★★ 这两条必须加 android:usesPermissionFlags="neverForLocation"，
             否则系统会因定位用途而额外要求 ACCESS_FINE_LOCATION，且会被算作位置信息采集。
        ★ API 30 及以下走 legacy：BLUETOOTH / BLUETOOTH_ADMIN（normal，安装即授予），
          但**扫描仍需 ACCESS_FINE_LOCATION**（上面已声明）。
        ★ BLUETOOTH_CONNECT 是运行时权限，即使用户在系统里已配对该模块，
          缺它时 connectGatt 也会抛 SecurityException。
    -->
    <!-- Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 及以下（legacy 扫描/配对；API 31 起系统会忽略这两条） -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!--
      声明需要 BLE 外设：Android 11+ 包可见性过滤会让蓝牙扫描看不到「未配对且不主动声明
      intent-filter」的设备；加上这个 uses-feature 后系统才不会把 BLE 扫描静默过滤掉。
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <!--
      ★★★ Android 13 (API 33) 起 Wi-Fi P2P 归到「附近设备」权限族：缺这一条时
      WifiP2pManager.discoverPeers / requestPeers 会被框架**直接拒绝**，
      回调 onFailure(reason=0) = P2P_UNSUPPORTED，且 requestPeers 秒回**空列表**。
      症状与「supplicant 卡死」一模一样（见 docs/35 §4），极易误判。
      运行时权限（dangerous），必须由用户在系统设置里授予 —— 应用启动时自检并提示。
    -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!--
      ★★ 读固件包（2026-10-06 车边实测）：Android 11+ 起 `Download/` 下的 zip 属于
      **非媒体文件**，用文件路径 `new FileInputStream("/sdcard/Download/x.zip")` 直读会抛
      `EACCES (Permission denied)` —— 即使已经在设置里给了「媒体/图片」权限也没用，
      READ_MEDIA_* 只覆盖图片/视频/音频。
      两条出路，本 App 都留了：
        ① SAF（ACTION_OPEN_DOCUMENT）选包 —— 免任何权限，见 OtaActivity 「选包…」；
        ② MANAGE_EXTERNAL_STORAGE「所有文件访问」—— 声明后由用户在系统
           特殊权限页授予，授予后原路径直读立刻可用。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      ★ 不再声明 SYSTEM_ALERT_WINDOW：日志悬浮窗已删（2026-10-04）。
      日志现在显示在 OTA 操作台页内，平白多要一个悬浮窗授权页不值得。
    -->
    <!-- 推包时用 socket 主动外连，不需要 INTERNET；保留只为将来起本地 HTTP 服务 -->

    <!-- 广播配置需要看见目标包（Android 11+ 包可见性） -->
    <queries>
        <package android:name="com.cfmoto" />
    </queries>

    <!--
      ★ 独立投屏的前台服务使用 mediaProjection 类型（MediaProjection 令牌必须由此类服务持有）。
        API 34 起声明了 foregroundServiceType 就必须配套对应权限，否则 startForeground() 抛异常。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".ui.UiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />

        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!--
          ★ 单宿主 Activity（唯一入口 / LAUNCHER）：常驻底栏 + 5 个 Fragment
            （骑行记录 / OTA 推送 / 壁纸推送 / 仪表投屏 / 车辆诊断）。
            切 tab 只换 Fragment，底栏实例不重建 —— 这是 Material Design 的规范范式，
            也是消除「底栏抖动 / 无点击波纹 / 快速点击闪烁」的根因修复。
            外部入口（OtaPushService / StandaloneMirrorService 的通知）用
            EXTRA_TAB 指定初始 tab。
            adb: am start -n com.github.speedhunter/.ui.MainActivity
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.NoTabAnim">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          壁纸选图/裁切（uCrop）：仪表要两张定尺图——
          1.png 307×460（小图/card）、2.png 1024×600（大图/背景）。
          主题必须是 AppCompat Light NoActionBar（uCrop 自身控件依赖），不要用 AppTheme。
        -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!--
          ★ socket_l OTA 推送期间的前台服务：106MB / 约 26000 帧要跑一两分钟，
            进程被回收会导致车机侧「已收 != 总长」、文件停在半截且不可回退。
            协议已通过固件交叉验证，见 docs/47。入口为 MainActivity 的「OTA 推送」tab。
        -->
        <service
            android:name=".ota.OtaPushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          ★ 独立投屏（社区 3.6.x）：不依赖官方 App / LSPosed，
            App 自身抓屏 → H.264 编码 → 经 EC/PXC 通道推给仪表。
            foregroundServiceType=mediaProjection 是 MediaProjection 令牌的硬性要求（API 29+）。
        -->
        <service
            android:name=".mirror.StandaloneMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 投屏流畅度自测画面：区分「导航 App 自身低刷新」与「投屏链路问题」 -->
        <activity
            android:name=".mirror.MirrorTestActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!--
          压弯标定页：运行时调压弯/急刹阈值，每项都带「调它会发生什么」说明。
          adb: am start -n com.github.speedhunter/.ui.TuneActivity
        -->
        <activity
            android:name=".ui.TuneActivity"
            android:exported="false"
            android:label="压弯标定"
            android:theme="@style/AppTheme" />

        <!-- 开关的跨进程读取通道：hook 进程（com.cfmoto）从这里 query -->
        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.github.speedhunter.settings"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- ZXing 扫码页（私有、锁定竖屏）：由库管理相机预览与释放 -->
        <activity
            android:name=".ui.MirrorCaptureActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:label="扫描仪表投屏二维码"
            android:screenOrientation="portrait"
            android:theme="@style/zxing_CaptureTheme" />
    </application>

</manifest>
