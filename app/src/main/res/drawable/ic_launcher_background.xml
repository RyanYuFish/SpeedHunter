<?xml version="1.0" encoding="utf-8"?>
<!--
  SpeedHunter 启动器图标 · 背景层（Material Design 自适应图标规范）

  自适应图标必须由 background / foreground / monochrome 三个 drawable 组成。
  此前误把底色写成了 values/colors.xml 里的 @color，导致每次改色都要动 colors.xml；
  这里改成标准做法——底色是一个独立的 drawable。

  主题化（Monet）生效时，系统会用壁纸取到的动态色覆盖这一层；
  仅当启动器不套主题化时，才直接显示这里的白底（干净、无品牌红棕、无色偏）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0h108v108H0z" />
</vector>
