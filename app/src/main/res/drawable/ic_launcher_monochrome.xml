<?xml version="1.0" encoding="utf-8"?>
<!--
  SpeedHunter 启动器图标 · **monochrome 图层**（Material You 主题图标专用）

  ★ 系统只取这一层的<b>轮廓</b>，用 Monet 从壁纸取到的颜色重新着色，画在动态色底板上。
    因此：
      · 必须是<b>单色、无背景</b>的剪影（fillColor / strokeColor 会被系统 tint 覆盖，写白即可）；
      · 图形必须落在中央 66dp 安全区（21..87）内（本图 x≈30..68、y≈34..80，全部在内）；
      · **坐标直接写进 108 视口，不使用 &lt;group&gt; 变换**；
      · 造型与 foreground 完全一致（戴斗篷的骑行小人 + 简洁自行车），
        保证主题图标与常规图标是同一图形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 车轮（环形） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M30,70a10,10 0 1,0 20,0a10,10 0 1,0 -20,0zM34,70a6,6 0 1,0 12,0a6,6 0 1,0 -12,0zM58,70a10,10 0 1,0 20,0a10,10 0 1,0 -20,0zM62,70a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />

    <!-- 车架 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,70 L47,56 M54,70 L63,56 M47,56 L63,56 M63,56 L68,70 M63,56 L66,52"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />

    <!-- 骑手：头 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58,34a5,5 0 1,0 0,10a5,5 0 1,0 0,-10z" />

    <!-- 躯干 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49,54 L56,45"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.5" />

    <!-- 手臂 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M56,45 L63,53"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- 腿 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49,54 L54,68"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />

    <!-- 斗篷 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,44 C46,39 36,41 31,49 C38,52 46,52 53,50 Z" />
</vector>
