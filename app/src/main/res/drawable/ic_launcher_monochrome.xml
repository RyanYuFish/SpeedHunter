<?xml version="1.0" encoding="utf-8"?>
<!--
  SpeedHunter 启动器图标 · **monochrome 图层**（Material You 主题图标专用）

  ★ 系统只取这一层的<b>轮廓</b>，用 Monet 从壁纸取到的颜色重新着色，画在动态色底板上。
    因此：
      · 必须是<b>单色、无背景</b>的剪影（fillColor / strokeColor 会被系统 tint 覆盖，写白即可）；
      · 图形必须落在中央 66dp 安全区（21..87）内（本图 x≈28..80、y≈31..79，全部在内）；
      · **坐标直接写进 108 视口，不使用 &lt;group&gt; 变换** —— 个别启动器抽取 monochrome
        时对嵌套变换处理不一致，会导致图形错位甚至取到空图；
      · 造型与 foreground 完全一致（Material Icons 风格骑行小人 + 自行车，无斗篷、缩小），
        保证主题图标与常规图标是同一图形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 车轮（环形） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M28,68a11,11 0 1,0 22,0a11,11 0 1,0 -22,0zM33,68a6,6 0 1,0 12,0a6,6 0 1,0 -12,0zM58,68a11,11 0 1,0 22,0a11,11 0 1,0 -22,0zM63,68a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />

    <!-- 车架 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,68 L47,54 M54,68 L61,54 M47,54 L61,54 M54,68 L39,68 M39,68 L47,54 M61,54 L69,68"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />

    <!-- 座垫 + 车把 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M61,54 L64,50 M47,54 L49,51"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- 牙盘 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,65.5a2.5,2.5 0 1,0 0,5a2.5,2.5 0 1,0 0,-5z" />

    <!-- 骑手：头 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58,31.5a5.5,5.5 0 1,0 0,11a5.5,5.5 0 1,0 0,-11z" />

    <!-- 躯干 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49,52 L56,43"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.5" />

    <!-- 手臂 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M56,43 L61,53"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- 腿 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49,52 L55,61 L53,67"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />
</vector>
