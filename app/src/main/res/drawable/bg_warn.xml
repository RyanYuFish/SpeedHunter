<?xml version="1.0" encoding="utf-8"?>
<!--
  刷写风险警告横幅：琥珀语义色（@color/warn_container + warn_stroke）。
  夜间模式自动换深橄榄底（values-night/colors.xml），文字色由布局里的
  @color/warn_* 跟随 —— 不再是硬编码浅黄。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/warn_container" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/warn_stroke" />
</shape>
