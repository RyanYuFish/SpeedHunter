<?xml version="1.0" encoding="utf-8"?>
<!--
  SpeedHunter 启动器图标 · 前景（Material Design 自适应图标规范）

  规范要点：
    · 108×108dp 视口，图形落在中央 **66dp 安全区**（21..87）内，并刻意缩小，
      任何形状的遮罩都裁不掉；
    · 前景只画图形，不带背景（背景由 adaptive-icon 的 background 提供，现为中性灰）；
    · 坐标直接写进 108 视口、**不用 <group> 变换**。

  造型：Material Icons 风格的「骑行小人 + 自行车」线稿（无斗篷、简洁），车头朝右。
  前景色用近黑 #212121，落在浅灰底上，在「非主题化」回退时依然清晰。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 车轮（环形，evenOdd 挖出内孔） -->
    <path
        android:fillColor="#212121"
        android:fillType="evenOdd"
        android:pathData="M28,68a11,11 0 1,0 22,0a11,11 0 1,0 -22,0zM33,68a6,6 0 1,0 12,0a6,6 0 1,0 -12,0zM58,68a11,11 0 1,0 22,0a11,11 0 1,0 -22,0zM63,68a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />

    <!-- 车架：座管 / 下管 / 上管 / 后下叉 / 后上叉 / 前叉 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,68 L47,54 M54,68 L61,54 M47,54 L61,54 M54,68 L39,68 M39,68 L47,54 M61,54 L69,68"
        android:strokeColor="#212121"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />

    <!-- 座垫 + 车把 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M61,54 L64,50 M47,54 L49,51"
        android:strokeColor="#212121"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- 牙盘（曲柄中心） -->
    <path
        android:fillColor="#212121"
        android:pathData="M54,65.5a2.5,2.5 0 1,0 0,5a2.5,2.5 0 1,0 0,-5z" />

    <!-- 骑手：头（近圆，图标尺寸下读作头盔） -->
    <path
        android:fillColor="#212121"
        android:pathData="M58,31.5a5.5,5.5 0 1,0 0,11a5.5,5.5 0 1,0 0,-11z" />

    <!-- 躯干（俯身前倾） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49,52 L56,43"
        android:strokeColor="#212121"
        android:strokeLineCap="round"
        android:strokeWidth="4.5" />

    <!-- 手臂（肩 → 车把） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M56,43 L61,53"
        android:strokeColor="#212121"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- 腿（髋 → 膝 → 脚踏，蹬踏姿势） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49,52 L55,61 L53,67"
        android:strokeColor="#212121"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />
</vector>
