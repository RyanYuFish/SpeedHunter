<resources>
    <!-- 应用名：LSPosed 管理器列表 / 系统设置里显示 -->
    <string name="app_name">SpeedHunter</string>

    <!-- Xposed 模块描述：LSPosed 管理器里显示（对应 Manifest 的 xposeddescription） -->
    <string name="xposed_description">解锁骑行记录完整数据。</string>

    <!-- 「压弯标定」页说明。写在资源里而不是 layout 里：
         layout 文本节点里的 \n / &#10; 在 aapt2 下不可靠（实测渲染成字面量），
         而 string 资源里的 \n 一定会被解析成换行。 -->
    <string name="tune_howto">拖动下面任意滑块 → 回官方 App「我的骑行 → 历史轨迹」逐月翻一遍 → 数字立刻按新参数重算。\n\n改完参数必须点「清空账本重算」：已经落盘的汇总是用旧参数算的，不会自动更新（原始轨迹不常驻，只留汇总）。</string>
</resources>
