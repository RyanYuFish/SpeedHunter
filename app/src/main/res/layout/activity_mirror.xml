<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_mirror"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_clear_log"
                    style="@style/TopIconButton"
                    android:contentDescription="清空日志"
                    android:src="@drawable/ic_delete_log" />
            </LinearLayout>

            <TextView
                style="@style/PageTitle"
                android:layout_marginTop="8dp"
                android:text="仪表投屏" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/ParamHelp"
                android:layout_marginTop="2dp"
                android:text="Wi-Fi Direct · SpeedHunter 独立屏幕投影" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="投屏二维码 / 连接信息"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        style="@style/ParamHelp"
                        android:layout_marginTop="2dp"
                        android:text="使用相机扫描仪表投屏二维码，自动填入并解析连接信息；也可粘贴完整 URL。无需运行官方 App，也无需启用 LSPosed。" />

                    <EditText
                        android:id="@+id/et_mirror_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="完整投屏二维码 URL（含 name、action）"
                        android:inputType="textUri"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scan_mirror_qr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="使用相机扫描二维码" />

                    <TextView
                        android:id="@+id/tv_mirror_info"
                        style="@style/ParamHelp"
                        android:layout_marginTop="8dp"
                        android:text="扫码或粘贴 URL 后，自动显示连接信息" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_parse_url"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="解析二维码 URL" />

                    <!-- 系统 Wi-Fi 直连（主）+ App 内直连（兜底）+ 网络诊断，共用连接条 -->

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="开始投屏"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        style="@style/ParamHelp"
                        android:layout_marginTop="2dp"
                        android:text="仪表停留在投屏二维码页，手机开启 WLAN、关闭个人热点。允许 SpeedHunter 使用附近设备（旧系统需定位）及共享屏幕；切换至导航 App 后继续投影。" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_smooth"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:checked="true" android:text="流畅模式（连续帧，使用下方档位）" />
                    <TextView style="@style/ParamHelp" android:text="默认开启，建议先用平衡档测试横屏。若仪表花屏可关闭后重连。档位码率用于连续帧，兼容模式保留原编码配置。切换需停止后重新开始。" />
                    <Spinner android:id="@+id/spinner_mirror_quality"
                        android:layout_width="match_parent" android:layout_height="48dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_mirror"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="开始独立 Wi-Fi Direct 投屏" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mirror_test" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="打开流畅度测试画面" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ec_probe"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="选择仪表" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop_mirror"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="停止投屏并断开" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="就绪 · 请使用仪表投屏二维码"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="运行日志"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView android:id="@+id/tv_mirror_perf"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="性能统计：等待视频传输…"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_log_pane"
                android:fadeScrollbars="false"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:scrollbarStyle="insideOverlay"
                android:scrollbars="vertical"
                android:text="等待操作…"
                android:textColor="#1A1111"
                android:textSize="11sp" />

            <TextView
                style="@style/ParamHelp"
                android:layout_marginTop="14dp"
                android:text="流程：二维码 → 本机 P2P 配对 → EC/PXC 握手 → H.264 屏幕投影。不需要官方 App。视频已发送不等于仪表已解码，最终以仪表实际画面为准。此版本需要实车验证。" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底栏（常驻）：与其余 tab 页共用同一份 -->
    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
