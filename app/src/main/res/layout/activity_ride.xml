<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_ride"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- ===== 顶栏：标题 + 状态胶囊（MD3 TopAppBar） ===== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:subtitle="Not only Unleash more information for ZEEHO"
            app:subtitleTextAppearance="@style/ToolbarSubtitle"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant"
            app:title="Speed Hunter"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== 骑行记录页：其余功能走底栏直开 Activity，不在此囤容器 ===== -->
    <FrameLayout
        android:id="@+id/ride_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ===== ① 骑行记录 ===== -->
        <ScrollView
            android:id="@+id/page_ride"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/root_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <!-- 当前挂载方式（状态卡）：激活 = 「已激活」+ 实现方式注释；全关 = 「未激活」 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <ImageView
                            android:id="@+id/ic_status"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_circle"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已激活"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:id="@+id/tv_status_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.85"
                                android:text="—"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_mode_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="WEB"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 挂载方式开关 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_public"
                                app:tint="?attr/colorPrimary" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="网络层改写（推荐）" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="hook okhttp 响应，改写车型能力位 —— 与 iOS Shadowrocket 方案同一组字段" />
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_web"
                                style="@style/SettingRowSwitch" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_public"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="G1 · vehicleKinds = 2" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="「骑行分析」入口 + 极速" />
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_g1"
                                style="@style/SettingRowSwitch" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_public"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="G2 · cyclingEventStatisticFlag = true" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="急加速 / 急刹 / 压弯" />
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_g2"
                                style="@style/SettingRowSwitch" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_visibility"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="视图层强制显示（兜底）" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="旧方案：把控件沿祖先链点亮，网络层失效时才用" />
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_view"
                                style="@style/SettingRowSwitch" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 骑行数据回填 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_visibility"
                                app:tint="?attr/colorPrimary" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="急刹 / 压弯回填" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="从行程轨迹还原缺失的急刹 / 压弯数；只补 0 值，服务端有数的不动" />
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_ride_fill"
                                style="@style/SettingRowSwitch" />
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="怎么补全" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="「历史轨迹」按月发请求且没有上拉加载，故自动把每页 20 条放大到 200 条；逐月点开即可补齐" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tune"
                                app:tint="?attr/colorPrimary" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="压弯标定" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="嫌压弯次数太多 / 太少？8 个阈值实时可调，改完翻一遍历史轨迹即可重算" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_tune"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="标定"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 版本 / 应用改动 / 数据说明 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="版本 · 目标应用" />
                                <TextView
                                    android:id="@+id/tv_version"
                                    style="@style/SettingRowSubtitle"
                                    android:text="com.cfmoto（LSPosed 作用域需勾选）" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="应用改动" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="开关实时送达运行中的 ZEEHO App；改动后建议冷重启一次确认效果" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/SettingDivider" />

                        <LinearLayout style="@style/SettingRow">
                            <ImageView
                                style="@style/SettingRowIcon"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info"
                                app:tint="?attr/colorOnSurfaceVariant" />
                            <LinearLayout style="@style/SettingRowText">
                                <TextView
                                    style="@style/SettingRowTitle"
                                    android:text="数据说明" />
                                <TextView
                                    style="@style/SettingRowSubtitle"
                                    android:text="只改能力位，极速/加速/急刹/压弯数值均为服务端真值" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- ===== 底栏：与其余 4 个 tab 页共用同一份 view_bottom_nav ===== -->
    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
