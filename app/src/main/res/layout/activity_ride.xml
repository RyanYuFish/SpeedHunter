<?xml version="1.0" encoding="utf-8"?>
<!--
  骑行记录页（v4.7.70 改版）：OTA 推送页式功能分区（bg_card + 图标节头）。
  分区顺序（车主指定）：网络层改写 → 急刹压弯回填 → 车模替换 → 自定义车控；
  自定义按键拆为二级页（CustomKeyActivity），本页只留入口行。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_ride"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/ride_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/page_ride"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/root_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <TextView
                    style="@style/PageTitle"
                    android:layout_marginTop="8dp"
                    android:text="Speed Hunter" />

                <TextView
                    style="@style/ParamHelp"
                    android:layout_marginTop="2dp"
                    android:text="车辆功能增强模块" />

                <!-- 状态卡：三态（已激活 / 未修改 / 未挂载）由 RideFragment.updateStatus 刷 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_mode_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="WEB"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnPrimary" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/ic_status"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check_circle"
                                app:tint="?attr/colorOnPrimaryContainer" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="已激活"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/tv_status_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.85"
                            android:lineSpacingMultiplier="1.25"
                            android:text="—"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/tv_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:alpha="0.8"
                            android:text="v4.8.0 · com.cfmoto（LSPosed 作用域需勾选）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.8"
                            android:text="开关实时生效；改动后建议冷重启官方 App 确认效果"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==================== 分区 ① 网络层改写 ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sym_swap_wheel"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="网络层改写"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow"
                        android:layout_marginTop="6dp">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_public"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="网络层改写（推荐）" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="开启后被隐藏的功能正常显示" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_web"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_public"
                            app:tint="?attr/colorOnSurfaceVariant" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="G1 · vehicleKinds = 2" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="「骑行分析」入口 + 极速" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_g1"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_public"
                            app:tint="?attr/colorOnSurfaceVariant" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="G2 · cyclingEventStatisticFlag = true" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="急加速 / 急刹 / 压弯" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_g2"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_visibility"
                            app:tint="?attr/colorOnSurfaceVariant" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="视图层强制显示" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="网络层失效时的备用方案" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_view"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== 分区 ② 急刹压弯回填 ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sym_roundabout"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="急刹压弯回填"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow"
                        android:layout_marginTop="6dp">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_visibility"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="急刹 / 压弯回填" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="自动翻取历史轨迹，补齐缺失的急刹 / 压弯记录" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_ride_fill"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_info"
                            app:tint="?attr/colorOnSurfaceVariant" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="怎么补全" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="在「历史轨迹」里逐月点开即可补齐" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tune"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="压弯标定" />
                            <TextView
                                style="@style/SettingRowSubtitle"
                                android:text="8 个阈值实时可调" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_tune"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="标定"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== 分区 ③ 车模替换 ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sym_transportation"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="车模替换"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow"
                        android:layout_marginTop="6dp">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_public"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="车模替换" />
                            <TextView
                                android:id="@+id/tv_vehicle_art_hint"
                                style="@style/SettingRowSubtitle"
                                android:text="关闭：主页车辆保持原样" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_vehicle_art"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_vehicle_art_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="3D 车模（点选车型）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_vehicle_art_model_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="未设置（跟随云端，点此选择）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_vehicle_art_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2D 车图 / 主题色（点选）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_vehicle_art_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="未设置（点此选择）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_vehicle_art_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="车漆配色（3D 模型加载后应用）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_vehicle_art_color_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="关闭（按模型默认色）"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== 分区 ④ 自定义车控 ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sym_auto_trans"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="自定义车控"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow"
                        android:layout_marginTop="6dp">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sym_cardiology"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="ABS 开关" />
                            <TextView
                                android:id="@+id/tv_abs_hint"
                                style="@style/SettingRowSubtitle"
                                android:text="关闭：云端数据保持原样" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_abs"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sym_motion_blur"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="氮气加速" />
                            <TextView
                                android:id="@+id/tv_nitro_hint"
                                style="@style/SettingRowSubtitle"
                                android:text="关闭：云端数据保持原样" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_nitro"
                            style="@style/SettingRowSwitch" />
                    </LinearLayout>

                    <View style="@style/SettingDivider" />

                    <!-- 自定义按键：二级页面入口 -->
                    <LinearLayout
                        android:id="@+id/row_custom_key_entry"
                        style="@style/SettingRow"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sym_toys"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="自定义按键" />
                            <TextView
                                android:id="@+id/tv_custom_key_summary"
                                style="@style/SettingRowSubtitle"
                                android:text="未开启" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 账号引导登录 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout style="@style/SettingRow">
                        <ImageView
                            style="@style/SettingRowIcon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_public"
                            app:tint="?attr/colorPrimary" />
                        <LinearLayout style="@style/SettingRowText">
                            <TextView
                                style="@style/SettingRowTitle"
                                android:text="账号引导登录" />
                            <TextView
                                android:id="@+id/tv_account_entry_hint"
                                style="@style/SettingRowSubtitle"
                                android:text="填入 token + 账号 ID，用于签到与积分任务" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="登录"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>